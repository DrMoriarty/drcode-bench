# Матрица моделей бенчмарка (план drcode-bench.md, §8).
#
# Формат провайдеров повторяет models.json.example drcode (Provider/ModelEntry
# в src/drcode/providers.py): base_url + api_key + список моделей с
# max_context_tokens / max_tokens / compaction_threshold.
#
# api_key поддерживает подстановку из окружения хоста: "env:NAME" читает
# переменную NAME при генерации config-home/drcode/models.json. Пустая строка
# = без ключа (локальные OpenAI-совместимые шлюзы).

[providers.copilot]
base_url = "https://api-copilot.x5.ru/aigw/v1"
api_key  = "f10f0a76-2939-4b49-907c-f27c087d2837"

[providers.copilot.models.copilot-code-large]
max_context_tokens = 262144
max_tokens = 16384

[providers.copilot.models.x5-airun-large-thinking]
max_context_tokens = 131072
max_tokens = 16384

[providers.copilot.models.x5-airun-medium-thinking]
max_context_tokens = 65536
max_tokens = 4096

[providers.copilot.models.x5-airun-small-thinking]
max_context_tokens = 262000
max_tokens = 16384

# Комбинации: роль → "provider/model-id". Ровно эти три роли поддерживает
# drcode.providers.AgentRole: coding / tester / compaction.
#
# Обязательные «угловые» комбинации матрицы (план §8):
#   - baseline-single-model      — все роли на одной модели (базлайн);
#   - strong-coder/cheap-tester  — тестер слабее кодера (поймает ли он
#                                  баг вообще); у неё кодер и тестер на
#                                  РАЗНЫХ провайдерах — recorder-лог
#                                  (model_log.jsonl) разделяет роли по
#                                  тегу model@base_url, что нужно
#                                  recorder-проверке гейта в S6;
#   - degradation-weak-compactor — слабый компактизатор: деградация
#                                  summary; failure компакции не роняет
#                                  ран (защищено в drcode, бенчмарк
#                                  подтверждает — см. отчёт §10).

[[combo]]
name       = "baseline-single-model"
coding     = "copilot/copilot-code-large"
tester     = "copilot/copilot-code-large"
compaction = "copilot/copilot-code-large"

[[combo]]
name       = "strong-coder/cheap-tester"
coding     = "copilot/copilot-code-large"
tester     = "copilot/x5-airun-small-thinking"
compaction = "copilot/x5-airun-small-thinking"

[[combo]]
# То же самое через ПЕРЕОПРЕДЕЛЕНИЕ на роль из combo (план §1.2, этап 4):
# coding_max_context_tokens записывается в entry каталога models.json —
# слой, перекрывающий flat config для роли; env (DRCODE_MAX_CONTEXT_TOKENS)
# не нужен и в прогоне всё равно вычищается (§13).
name       = "s3-coder-small-ctx"
coding     = "copilot/copilot-code-large"
tester     = "copilot/x5-airun-small-thinking"
compaction = "copilot/x5-airun-small-thinking"
coding_max_context_tokens = 5000

[[combo]]
# S4: маленький контекст — у роли ТЕСТЕРА: с drcode ≥ 0.5.0 модели
# разрешаются пер-ролево, и mid-round гейт тестера делит на конфиг
# тестеровой модели (_fill_over_threshold(..., AgentRole.TESTER), §1.2).
name       = "s4-tester-compaction"
coding     = "copilot/copilot-code-large"
tester     = "copilot/x5-airun-small-thinking"
compaction = "copilot/x5-airun-small-thinking"
# Репортед usage отстаёт от фактического промпта (~на 30%): при каталожных
# 262144 кодер уходил в паузу с фактическими ~291K токенов, и компактор
# (реальный лимит шлюза 262144) отвечал 400 на каждую компакцию — прогон
# не добирался до тестера. 180000: триггер ~84% ≈ 151K репортеда ≈ 200K
# факта — компакция проходит до упора в реальный контекст.
coding_max_context_tokens = 180000
tester_max_context_tokens = 3000

[[combo]]
# Деградационная combo (план §8, «слабый компактизатор»): компактизатор —
# самая маленькая модель матрицы; summary ожидаемо хуже, возможны
# «compaction failed» / повторные компакции. drcode обязан переживать это
# без падения прогона (gate отключается, ран идёт несжатым) — бенчмарк
# распознаёт состояние и отмечает его в отчёте (§1.2, §10).
name       = "degradation-weak-compactor"
coding     = "copilot/copilot-code-large"
tester     = "copilot/x5-airun-small-thinking"
compaction = "copilot/x5-airun-small-thinking"
compaction_max_context_tokens = 4096
